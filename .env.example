# Ledger-agent configuration — all optional; sensible defaults shown.
# Everything runs locally against Ollama. No API keys, nothing leaves the box.

# Ollama server
OLLAMA_URL=http://localhost:11434

# Chat model used for classification (pull with: ollama pull llama3.2)
CHAT_MODEL=llama3.2

# Embedding model used for rule/correction retrieval (ollama pull nomic-embed-text)
EMBED_MODEL=nomic-embed-text

# SQLite database file (regenerated by `npm run setup`)
DB_PATH=ledger.db
